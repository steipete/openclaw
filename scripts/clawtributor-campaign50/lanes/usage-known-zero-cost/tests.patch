+        { value: "$0.00", empty: false },
+        { value: "$0.00", empty: false },
+      ]);
+      expect(observations[0]?.hint).toBe(missingHint);
+      expect(observations[2]?.hint).toBe(missingHint);
+      expect(observations[1]?.hint, "USAGE_KNOWN_ZERO_FILTER").toBe(normalHint);
+    },
+  );
+});
 
