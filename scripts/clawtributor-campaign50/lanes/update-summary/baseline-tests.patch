+        { name: "missing", exitCode: null, stderrTail: "" },
+        ...(status === "error" ? [{ name: "pending", exitCode: null, stderrTail: "" }] : []),
+        { name: "failed", exitCode: 1, stderrTail: "" },
+      ],
