+      reason: text,
+      failedSteps: [{ name: text, exitCode: 1, stderrTail: text }],
+    });
+  });
+
+  it.each(["error", "skipped"])("retains the selected %s update steps in order", async (status) => {
+    dispatchMock.mockResolvedValue({
