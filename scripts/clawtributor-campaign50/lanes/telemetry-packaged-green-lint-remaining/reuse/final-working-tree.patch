+    { name: "implicit help", args: ["help"], usage: "telemetry [options] [command]" },
+    { name: "nested help", args: ["help", "show"], usage: "telemetry show [options]" },
+  ])("preserves $name without reading or changing telemetry", async ({ args, usage }) => {
