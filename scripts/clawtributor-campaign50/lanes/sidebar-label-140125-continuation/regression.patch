+    const page = await context.newPage();
+    const mainVideo = page.video();
+    if (!mainVideo) throw new Error("Link proof recording is missing");
+    const videos = [{ page: "links-main", file: path.basename(await mainVideo.path()) }];
+    const saveVideos = () =>
+      writeFile(path.join(suite.artifactDir, "page-videos.json"), JSON.stringify(videos, null, 2));
+    await saveVideos();
+    const gateway = await installMockGateway(page);
+    const observations: unknown[] = [];
+    const menuSettlements: unknown[] = [];
+    const submenuSettlements: unknown[] = [];
+    const saveGeometry = () =>
+      writeFile(
+        path.join(suite.artifactDir, "nested-link-geometry.json"),
+        JSON.stringify(
+          {
+            observations,
+            menuSettlements,
+            submenuSettlements,
+          },
+          null,
+          2,
+        ),
+      );
+    const openDropdown = async (trigger: Locator, selector: string) => {
+      const gate = await page.evaluateHandle((selector) => {
+        const state = { completed: false, scale: "", transform: "" };
+        const onShown = (event: Event) => {
+          if (!(event.target instanceof HTMLElement) || !event.target.matches(selector)) return;
+          const surface = event.target.shadowRoot?.querySelector('[part~="menu"]');
+          if (!(surface instanceof HTMLElement)) return;
+          const style = getComputedStyle(surface);
+          Object.assign(state, { completed: true, scale: style.scale, transform: style.transform });
+          document.removeEventListener("wa-after-show", onShown, true);
+        };
+        document.addEventListener("wa-after-show", onShown, true);
+        return {
+          state,
+          dispose: () => document.removeEventListener("wa-after-show", onShown, true),
+        };
+      }, selector);
+      try {
+        await trigger.click();
+        await expect.poll(() => gate.evaluate((owner) => owner.state.completed)).toBe(true);
+      } finally {
+        const state = await gate.evaluate((owner) => {
+          owner.dispose();
+          return owner.state;
+        });
+        await gate.dispose();
+        menuSettlements.push({ selector, ...state });
+        await saveGeometry();
+      }
+    };
+    const openHelpSubmenu = async (help: Locator, direction: string, scale: number) => {
+      const submenu = help.locator('[part="submenu"]');
+      await submenu.waitFor({ state: "attached" });
+      const gate = await submenu.evaluateHandle((surface) => {
+        if (
+          !(surface instanceof HTMLElement) ||
+          !surface.hidden ||
+          surface.classList.contains("show")
+        ) {
+          throw new Error("Help submenu must be closed before observing its opening");
+        }
+        const state = {
+          seenShow: false,
+          completed: false,
+          stages: [] as Array<Record<string, unknown>>,
+        };
+        const observer = new MutationObserver((records) => {
+          state.seenShow ||=
+            surface.classList.contains("show") ||
+            records.some((record) => (record.oldValue ?? "").split(/\s+/).includes("show"));
+          const root = surface.getRootNode();
+          const open =
+            root instanceof ShadowRoot && root.host.getAttribute("aria-expanded") === "true";
+          const style = getComputedStyle(surface);
+          const rect = surface.getBoundingClientRect();
+          state.stages.push({
+            className: surface.className,
+            hidden: surface.hidden,
+            open,
+            scale: style.scale,
+            transform: style.transform,
+            width: rect.width,
+            layoutWidth: surface.offsetWidth,
+            animations: surface.getAnimations().map((animation) => animation.playState),
+          });
+          if (
+            state.seenShow &&
+            open &&
+            !surface.hidden &&
+            surface.hasAttribute("data-visible") &&
+            !surface.classList.contains("show") &&
+            !surface.classList.contains("hide")
+          ) {
+            state.completed = true;
+            observer.disconnect();
+          }
+        });
+        observer.observe(surface, {
+          attributes: true,
+          attributeFilter: ["class"],
+          attributeOldValue: true,
+        });
+        return { state, dispose: () => observer.disconnect() };
+      });
+      try {
+        await help.hover();
