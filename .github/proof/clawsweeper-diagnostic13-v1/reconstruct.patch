diff --git a/test/data-model-review-boundary.test.ts b/test/data-model-review-boundary.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..707b0cfd6c0d88c963b82aa766c58ff185dbeed7
--- /dev/null
+++ b/test/data-model-review-boundary.test.ts
@@ -0,0 +1,72 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+
+import {
+  dataModelChangeFromPullFilesForTest,
+  renderReviewCommentFromReport,
+  reviewAutomationMarkersFromReport,
+} from "../dist/clawsweeper.js";
+import { reviewReportFrontMatter } from "./helpers.ts";
+
+const cases: {
+  name: string;
+  pullFiles: { filename: string; status: string; patch: string }[];
+  expectedSurfaces: string[];
+}[] = ["query-owners", "schema-owners"].flatMap((fixture) =>
+  JSON.parse(
+    readFileSync(
+      new URL(`./fixtures/persistence-classifier-${fixture}.json`, import.meta.url),
+      "utf8",
+    ),
+  ),
+);
+
+for (const { name, pullFiles, expectedSurfaces } of cases) {
+  test(`data model review boundary: ${name}`, () => {
+    const detection = dataModelChangeFromPullFilesForTest({ pullFiles });
+    const change = expectedSurfaces.length > 0;
+    assert.deepEqual(detection, { change, surfaces: expectedSurfaces });
+
+    const report = `${reviewReportFrontMatter({
+      repository: "openclaw/openclaw",
+      type: "pull_request",
+      number: "123",
+      decision: "keep_open",
+      close_reason: "none",
+      work_candidate: "none",
+      review_status: "complete",
+      confidence: "high",
+      labels: JSON.stringify(["clawsweeper:automerge"]),
+      pull_head_sha: "a".repeat(40),
+      real_behavior_proof_status: "sufficient",
+      real_behavior_proof_needs_contributor_action: "false",
+      data_model_change: String(detection.change),
+      data_model_surfaces: JSON.stringify(detection.surfaces),
+    })}
+
+## Summary
+
+Synthetic completed review; no upgrade proof is supplied.
+
+## Review Findings
+
+Overall correctness: patch is correct
+
+Overall confidence: 0.9
+
+Full review comments:
+
+- none
+`;
+    const comment = renderReviewCommentFromReport(report, "none");
+    assert.equal(
+      /Persistent data-model change detected|### Stored data model/.test(comment),
+      change,
+    );
+    assert.equal(/Confirm migration or upgrade compatibility proof/.test(comment), change);
+    const markers = reviewAutomationMarkersFromReport(report);
+    assert.match(markers, change ? /clawsweeper-verdict:needs-human/ : /clawsweeper-verdict:pass/);
+    assert.doesNotMatch(markers, /clawsweeper-action:fix-required/);
+  });
+}
