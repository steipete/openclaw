+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import java.util.UUID
+
+/** The gate reifies preemption at the existing RPC seam; both paths use the same gate and real sockets. */
+@RunWith(RobolectricTestRunner::class)
+class ChatFullMessageDispatchTest {
+  @Test
+  fun admittedFullMessageReadDoesNotMoveToAReplacementSocket() = runBlocking {
+    val app = RuntimeEnvironment.getApplication() as NodeApp
+    val prefs = SecurePrefs(app, app.getSharedPreferences("full-message-wire-${UUID.randomUUID()}", Context.MODE_PRIVATE))
+    val gateway = FullMessageGateway()
+    val ownerJob = SupervisorJob()
+    val ownerScope = CoroutineScope(ownerJob + Dispatchers.Default)
+    val connected = MutableStateFlow(0)
+    val methods = MutableStateFlow<Set<String>?>(null)
+    val session = GatewaySession(
+      scope = ownerScope,
+      identityStore = testDeviceIdentityStore(app),
+      deviceAuthStore = DeviceAuthStore(prefs),
+      onConnected = { hello ->
+        methods.value = hello.methods
+        connected.update { it + 1 }
+      },
+      onDisconnected = { methods.value = null },
+      onEvent = { _, _ -> },
+    )
+    val atDispatch = CompletableDeferred<Unit>()
+    val releaseDispatch = CompletableDeferred<Unit>()
+    suspend fun awaitDispatch(method: String) {
+      if (method == "chat.message.get") {
+        atDispatch.complete(Unit)
+        releaseDispatch.await()
+      }
+    }
+    val controller = ownerScope.createChatController(
+      cacheScope = { ChatCacheScope(gateway.endpoint.stableId, 1L) },
+      supportsChatMessageGet = { methods.value?.contains("chat.message.get") == true },
+      gatewayAdvertisesMethod = { methods.value?.contains(it) },
+      requestGatewayForGateway = { gatewayId, method, params ->
+        awaitDispatch(method)
+        session.requestForEndpoint(gatewayId, method, params)
+      },
+      captureSettingsRequestLease = { scope ->
+        session.captureRequestLease(scope?.gatewayId)?.let { lease ->
+          GatewaySession.RequestLease(
+            endpointStableId = lease.endpointStableId,
+            isCurrentImpl = lease::isCurrent,
+            commitIfCurrentImpl = lease::commitIfCurrent,
+          ) { method, params, timeout ->
+            awaitDispatch(method)
+            lease.request(method, params, timeout)
+          }
+        }
+      },
+      requestGateway = { method, params -> session.request(method, params) },
+    )
+    try {
+      session.connect(
+        endpoint = gateway.endpoint,
+        token = "synthetic-full-message-proof",
+        bootstrapToken = null,
+        password = null,
+        options = GatewayConnectOptions(
+          role = "operator",
+          scopes = listOf("operator.read"),
+          caps = emptyList(),
+          commands = emptyList(),
+          permissions = emptyMap(),
+          client = GatewayClientInfo("openclaw-android-test", "Full message proof", "proof", "android", "ui", "full-message-proof", "android", "test"),
+        ),
+        tls = null,
+      )
+      withTimeout(FULL_MESSAGE_READY_TIMEOUT_MS) { connected.first { it == 1 } }
+      controller.load(FULL_MESSAGE_FIRST_CHAT, ownerAgentId = "main")
+      withTimeout(FULL_MESSAGE_READY_TIMEOUT_MS) {
+        controller.messages.first { it.singleOrNull()?.content?.singleOrNull()?.text == gateway.preview(FULL_MESSAGE_FIRST_CHAT) }
+      }
+      val oldConnection = gateway.operatorConnection.get()
+      val pending = async(start = CoroutineStart.UNDISPATCHED) { controller.loadFullAssistantMessage(FULL_MESSAGE_ENTRY) }
+      withTimeout(FULL_MESSAGE_READY_TIMEOUT_MS) { atDispatch.await() }
+      session.reconnect()
+      withTimeout(FULL_MESSAGE_READY_TIMEOUT_MS) { connected.first { it == 2 } }
+      assertTrue(gateway.operatorConnection.get() > oldConnection)
+      releaseDispatch.complete(Unit)
+      val retiredResult = withTimeout(FULL_MESSAGE_READY_TIMEOUT_MS) { pending.await() }
+      // Fresh admission proves the replacement is healthy and orders the final packet assertion.
+      val currentResult = controller.loadFullAssistantMessage(FULL_MESSAGE_ENTRY)
+      assertTrue(currentResult is ChatFullMessageLoadResult.Loaded)
+      assertEquals(
+        "An admitted read belongs to its physical connection, not merely the endpoint id",
+        listOf(FullMessageRead(gateway.operatorConnection.get(), FULL_MESSAGE_FIRST_CHAT, "main", FULL_MESSAGE_ENTRY)),
+        gateway.fullReads.toList(),
+      )
+      assertFalse(retiredResult is ChatFullMessageLoadResult.Loaded)
+    } finally {
+      releaseDispatch.complete(Unit)
+      try {
+        session.disconnect()
+      } finally {
+        try {
+          ownerJob.cancelAndJoin()
+        } finally {
+          gateway.close()
+        }
+      }
+    }
+  }
+}
